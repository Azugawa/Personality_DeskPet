; Engine configuration file.
; DeskPet - modular pixel-art desktop pet framework.
; Target: Godot 4 stable (verified with 4.7.2.stable).
;
; Desktop transparency is NOT enabled at startup. It is enabled at runtime only
; with the "--desktop-mode" command-line flag (see scripts/core/window_controller.gd),
; so normal editor/play debugging stays opaque.

config_version=5

[application]

config/name="DeskPet"
config/description="Persistent pixel-art desktop pet with eight-direction animation, behavior state machine and independent furniture."
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

EventBus="*res://scripts/events/event_bus.gd"
SceneManager="*res://scripts/core/scene_manager.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=720
window/size/resizable=false
window/size/transparent=false
window/size/borderless=false
window/size/always_on_top=false
window/per_pixel_transparency/allowed=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_2d=0
anti_aliasing/quality/screen_space_aa=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0, 0, 0, 0)
